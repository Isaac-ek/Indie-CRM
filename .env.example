# ==========================================
# Indie CRM - Environment Configuration Guide
# ==========================================

# Database Connection (PostgreSQL with pgvector support)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/indie_crm?schema=public"

# NextAuth / Authentication
AUTH_SECRET="replace-with-a-32-character-random-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Default Demo Credentials
DEMO_USER_PASSWORD="demo12345"

# OpenAI API Configuration (Optional: Deterministic mock mode used if blank)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Redis Cache & Rate Limiter (Optional: Uses fallback in-memory store if offline)
REDIS_URL="redis://localhost:6379"

# Structured Logging Configuration (trace, debug, info, warn, error, fatal)
LOG_LEVEL="info"

# Security & Webhook Secrets
FORM_WEBHOOK_SECRET="your-form-webhook-secret"
INTERNAL_CRON_SECRET="your-internal-cron-secret"
CRON_SECRET="your-vercel-cron-secret"
